    } else {
      if (summary) txt = txt sprintf("  p95 gate   %s vs %sms  %s\n", fmt(rp95), failover, \
                                       (rp95 > failover+0) ? "FAIL" : "ok")
      if (rp95 > failover+0) v = 1
    }
  }
  if (failerr != "") {
    erpct = runtot ? 100*runerr/runtot : 0
    if (summary) txt = txt sprintf("  err gate   %.1f%% vs %s%%  %s\n", erpct, failerr, \
                                     (erpct > failerr+0) ? "FAIL" : "ok")
