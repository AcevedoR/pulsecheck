}
# Three rows of eight block steps give 24 levels of vertical resolution; row 1
# is the bottom. A failed request is drawn at its measured height in red — a
# refusal that returned in microseconds is a red notch at the floor, a slow 503
# is a tall red column, and those are different facts worth telling apart.
function wave3(   i,k,j,off,newest,lvl,dist,c,g,r,base) {
  off = (wn > ww) ? wn - ww : 0
  newest = wn - off
  # The glint sweeps only the columns that hold samples, so it does not spend
  # most of its travel over an empty tail while the window fills. Without this
  # assignment spos stays 0 and columns 1 and 2 are lit forever, which is a
  # stationary smudge rather than a sweep.
  spos = (f <= SHF) ? int(newest*f/SHF) + 1 : -99
  for (r=1;r<=3;r++) { wrow[r]=""; wpc[r]="none" }
  for (i=1;i<=ww;i++) {
    k = off + i
    if (k > wn) {
      for (r=1;r<=3;r++) wrow[r] = wrow[r] " "
      continue
    }
    j = ((k-1) % ww) + 1
    lvl = wlevel(wms[j])
    c = wbad[j] ? RED : col(wms[j],0)
    dist = i - spos; if (dist < 0) dist = -dist
    if (i == newest && f <= 2) c = B WHT
    else if (dist == 0)        c = B WHT
    else if (dist <= 2)        c = B c
    for (r=1;r<=3;r++) {
      base = (r-1)*8
      if (lvl >= base+8)   g = BL[8]
      else if (lvl > base) g = BL[lvl-base]
      else                 g = ""
      if (g == "") { wrow[r] = wrow[r] " "; continue }
      if (c != wpc[r]) { wrow[r] = wrow[r] R c; wpc[r] = c }
      wrow[r] = wrow[r] g
    }
  }
  for (r=1;r<=3;r++) wrow[r] = wrow[r] R
  wrow[3] = wrow[3] sprintf(" %s┤%s %s%-9s%s", D, R, D, \
    (wn ? fmt(whi) (clipt ? "+" : "") : ""), R)
  wrow[1] = wrow[1] sprintf(" %s┤%s %s%-9s%s", D, R, D, \
    (wn ? fmt(wlo) (clipb ? "-" : "") : ""), R)
