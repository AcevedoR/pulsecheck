# The summary is written to a file rather than printed, because on a terminal
# the display is still on screen at this point and the shell prints it after the
# cursor and scroll region have been restored. The verdict goes to a second file
# so the exit status does not have to survive the fifo and the wait.
function writesummary(   rp50, rp95, mean, dur, v, txt) {
  if (!rundir) return
  v = 0
  mean = runok ? runsum/runok : 0
  dur = (runt1 > runt0) ? runt1 - runt0 : 0
  if (runok > 0) {
    rn = (runok < RCAP) ? runok : RCAP
    rp50 = pct(res, rn, 0.50)
    rp95 = (rn >= 20) ? pct(res, rn, 0.95) : -1
  }
  if (summary) {
    txt = sprintf("\npulsecheck summary\n")
    txt = txt sprintf("  target     %s  (%s)\n", url, mode)
    txt = txt sprintf("  requests   %d in %s", runtot, span_s(dur))
    if (dur > 0 && runtot > 1) txt = txt sprintf("  (one every %.2fs)", dur/(runtot-1))
