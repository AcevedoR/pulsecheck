      # dump it. stderr is unbuffered and streams line by line. -N does not
      # help, and a bare %stderr form prints literally.
      curl -s -K "$RUNDIR/curlrc" -K "$RUNDIR/urls" --rate "${RATE}/d" -m "$TMO" \
        -w '%{stderr}%{http_code} %{time_total} %{num_connects}\n' \
        2>"$RUNDIR/w" >/dev/null &
      echo $! > "$RUNDIR/curl.pid"
      while IFS= read -r L; do
        stamp
        SENT=$(( SENT + 1 ))
        # Stamped at completion, not at start: curl never reports a request
        # start, and completion is the instant --rate itself paces on.
        printf '%s %s.%s %s\n' "$CLK" "$SEC" "${NS:0:6}" "$L"
        [ -n "$T0" ] || T0=$EPMS
        SEQ=$(( SEQ + 1 ))
        LASTMS=$EPMS
        if [ "$COUNT" -gt 0 ] && [ "$SENT" -ge "$COUNT" ]; then
          : > "$RUNDIR/stop"
          break
        fi
      done < "$RUNDIR/w"
      # Stopping early means curl still has most of a batch queued — up to
      # 20 x --window requests — and waiting for it would turn `-c 5` into a
      # run of twelve hundred. Kill it first, then reap.
      if [ -e "$RUNDIR/stop" ] && [ -f "$RUNDIR/curl.pid" ]; then
        kill "$(cat "$RUNDIR/curl.pid" 2>/dev/null)" 2>/dev/null
      fi
      wait 2>/dev/null
      [ -e "$RUNDIR/stop" ] && break
      # Re-anchor to the grid before relaunching, so per-batch drift cannot
      # accumulate across the run.
      [ -n "$T0" ] || T0=$LASTMS
      K=$(( (LASTMS - T0) / IMS + 1 ))
      [ "$K" -gt "$SEQ" ] || K=$SEQ
      REM=$(( T0 + K * IMS - LASTMS ))
      [ "$REM" -gt 0 ] && sleep "$(printf '%d.%03d' $((REM/1000)) $((REM%1000)))"
      SEQ=$K
    done
  else
    while :; do
      stamp
      OUT=$(curl -s -K "$RUNDIR/curlrc" -o /dev/null -m "$TMO" \
            -w '%{http_code} %{time_total}' "$URL")
      # 6 fractional digits, not 9: an IEEE double holds about 16 significant
      # digits, so the last three would be lost silently. Truncating is plainer.
      # The trailing 0 is field 5: in fresh mode every request pays for its own
      # connection, so flagging them all would flag nothing. Field 5 means "this
      # sample paid for a handshake its neighbours did not".
      printf '%s %s.%s %s 0\n' "$CLK" "$SEC" "${NS:0:6}" "$OUT"
      SENT=$(( SENT + 1 ))
      # Counted when emitted, and the loop leaves before pacing for a sample it
      # is never going to send: otherwise -c 3 waits a full interval after the
      # third request before it will admit to being finished.
      if [ "$COUNT" -gt 0 ] && [ "$SENT" -ge "$COUNT" ]; then break; fi

      ELMS=$(to_ms "${OUT##* }")
      NOWMS=$(( EPMS + ELMS ))                # end of the request, estimated

      if [ "$NSOK" = 1 ]; then
        [ -n "$T0" ] || T0=$EPMS
        SEQ=$(( SEQ + 1 ))
        # First slot strictly in the future. A request that overruns its slot
        # SKIPS the missed ones; it never queues and never fires back to back,
        # so a recovering endpoint cannot be turned into a burst load test.
        K=$(( (NOWMS - T0) / IMS + 1 ))
        [ "$K" -le "$SEQ" ] || SEQ=$K
        REM=$(( T0 + SEQ * IMS - NOWMS ))
      else
        REM=$(( IMS - ELMS ))               # no sub-second clock for a grid
      fi

      [ "$REM" -gt 0 ] || REM=0
      [ "$REM" -eq 0 ] || sleep "$(printf '%d.%03d' $((REM/1000)) $((REM%1000)))"
    done
  fi
} > "$RUNDIR/stream" 2>/dev/null &
PROD=$!

wait "$PIPE"

# The run ended on its own (--count reached), rather than being interrupted.
# Read what awk left behind before stop() removes the run directory.
VERDICT=0
[ ! -f "$RUNDIR/verdict" ] || VERDICT=$(cat "$RUNDIR/verdict" 2>/dev/null || echo 0)
SUMTEXT=
[ ! -f "$RUNDIR/summary" ] || SUMTEXT=$(cat "$RUNDIR/summary" 2>/dev/null || true)
stop
# Printed after the display has been restored, so it lands under the final
# frame rather than inside a scroll region awk no longer owns.
[ -z "$SUMTEXT" ] || printf '%s\n' "$SUMTEXT"
case $VERDICT in ''|*[!0-9]*) VERDICT=0 ;; esac
exit "$VERDICT"
