  # "was this endpoint healthy for the duration" must not be decided by whatever
  # happened to be in the buffer at the moment the run stopped.
  if (failover != "") {
    if (runok == 0 || rp95 < 0) {
      if (summary) txt = txt sprintf("  p95 gate   —  (needs 20 successful requests, saw %d)\n", runok)
