}' < "$RUNDIR/stream" &
PIPE=$!

{
  if [ "$WAVE" = 1 ]; then
    while :; do printf 'TICK\n'; sleep "$FRAME"; done &
    TICKER=$!
    echo "$TICKER" > "$RUNDIR/ticker.pid"
    trap 'kill $TICKER 2>/dev/null' EXIT
  fi
  # Pacing is against an ABSOLUTE grid: sample n is due at T0 + n*interval.
  # Sleeping the full interval after each request measured +16.7% at -i 0.5 and
  # +92% against a 0.9s endpoint, because the request and the forks around it
  # are added to every period. Sleeping interval-minus-time_total still runs
  # +5.4%: it cannot see its own fork cost, so it is systematically late and the
  # error accumulates forever. The grid bounds the drift at sleep granularity.
  SEQ=0; T0=
  if [ "$MODE" = reuse ]; then
    # ONE curl per batch, holding one connection for BATCH requests. Measured on
    # a real API: 53ms per request with a fresh process against 16ms once the
    # connection is reused, so about 70% of what the old loop called latency was
    # handshake. curl paces within the batch via --rate; the grid below paces
    # between batches, because --rate fires the first request of a new batch
    # immediately (measured 0.07s gap, against 0.52s with the grid).
    LASTMS=0
    while :; do
      [ -e "$RUNDIR/stop" ] && break
      # -w goes to STDERR deliberately: curl block-buffers -w through a pipe and
      # delivers a whole batch at exit, which would freeze the display and then
      # dump it. stderr is unbuffered and streams line by line. -N does not
      # help, and a bare %stderr form prints literally.
      curl -s -K "$RUNDIR/headers" -K "$RUNDIR/urls" --rate "${RATE}/d" -m "$TMO" \
        -w '%{stderr}%{http_code} %{time_total} %{num_connects}\n' \
        2>"$RUNDIR/w" >/dev/null &
      echo $! > "$RUNDIR/curl.pid"
      while IFS= read -r L; do
        stamp
        # Stamped at completion, not at start: curl never reports a request
        # start, and completion is the instant --rate itself paces on.
        printf '%s %s.%s %s\n' "$CLK" "$SEC" "${NS:0:6}" "$L"
        [ -n "$T0" ] || T0=$EPMS
        SEQ=$(( SEQ + 1 ))
        LASTMS=$EPMS
      done < "$RUNDIR/w"
      wait 2>/dev/null
      [ -e "$RUNDIR/stop" ] && break
      # Re-anchor to the grid before relaunching, so per-batch drift cannot
      # accumulate across the run.
      [ -n "$T0" ] || T0=$LASTMS
      K=$(( (LASTMS - T0) / IMS + 1 ))
      [ "$K" -gt "$SEQ" ] || K=$SEQ
      REM=$(( T0 + K * IMS - LASTMS ))
      [ "$REM" -gt 0 ] && sleep "$(printf '%d.%03d' $((REM/1000)) $((REM%1000)))"
      SEQ=$K
    done
  else
    while :; do
      stamp
      OUT=$(curl -s -K "$RUNDIR/headers" -o /dev/null -m "$TMO" \
            -w '%{http_code} %{time_total}' "$URL")
      # 6 fractional digits, not 9: an IEEE double holds about 16 significant
      # digits, so the last three would be lost silently. Truncating is plainer.
      # The trailing 0 is field 5: in fresh mode every request pays for its own
      # connection, so flagging them all would flag nothing. Field 5 means "this
      # sample paid for a handshake its neighbours did not".
      printf '%s %s.%s %s 0\n' "$CLK" "$SEC" "${NS:0:6}" "$OUT"

      ELMS=$(to_ms "${OUT##* }")
      NOWMS=$(( EPMS + ELMS ))                # end of the request, estimated

      if [ "$NSOK" = 1 ]; then
        [ -n "$T0" ] || T0=$EPMS
        SEQ=$(( SEQ + 1 ))
        # First slot strictly in the future. A request that overruns its slot
        # SKIPS the missed ones; it never queues and never fires back to back,
        # so a recovering endpoint cannot be turned into a burst load test.
        K=$(( (NOWMS - T0) / IMS + 1 ))
        [ "$K" -le "$SEQ" ] || SEQ=$K
        REM=$(( T0 + SEQ * IMS - NOWMS ))
      else
        REM=$(( IMS - ELMS ))               # no sub-second clock for a grid
      fi

      [ "$REM" -gt 0 ] || REM=0
      [ "$REM" -eq 0 ] || sleep "$(printf '%d.%03d' $((REM/1000)) $((REM%1000)))"
    done
  fi
} > "$RUNDIR/stream" 2>/dev/null &
PROD=$!

wait "$PIPE"
