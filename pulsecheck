                   col(ms,bad), fmt(ms), R, D,R, DASH, D,R, DASH, D,R, DASH, D, R)
    else
      l3 = sprintf("last %s%-9s%s %sp50%s %s%-9s%s %sp95%s %s%-9s%s %smax%s %s%-9s%s %sover %d ok%s",
